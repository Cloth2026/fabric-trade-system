generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  active
  inactive
}

enum UserStatus {
  active
  inactive
}

enum FabricType {
  knitted
  woven
}

enum PricingUnit {
  kg
  meter
}

enum ConfigScope {
  system
  tenant
}

enum ProcessInfoStatus {
  none
  pending
  available
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  status               TenantStatus          @default(active)
  users                User[]
  suppliers            Supplier[]
  supplierUnits        SupplierUnit[]
  configOptions        ConfigOption[]
  fabrics              Fabric[]
  fabricSuppliers      FabricSupplier[]
  fabricSupplierQuotes FabricSupplierQuote[]
  batches              FabricStockInBatch[]
  customers            Customer[]
  customerContacts     CustomerContact[]
  sampleRequests       SampleRequest[]
  sampleRequestItems   SampleRequestItem[]
  logs                 OperationLog[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model User {
  id        String         @id @default(cuid())
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  tenantId  String
  email     String
  username  String
  name      String
  role      String         @default("admin")
  status    UserStatus     @default(active)
  logs      OperationLog[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId])
}

model ConfigOption {
  id        String      @id @default(cuid())
  tenant    Tenant?     @relation(fields: [tenantId], references: [id])
  tenantId  String?
  ownerKey  String      @default("system")
  scope     ConfigScope @default(system)
  group     String
  key       String
  label     String
  sortOrder Int         @default(0)
  enabled   Boolean     @default(true)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([ownerKey, group, key])
  @@index([tenantId])
  @@index([ownerKey])
  @@index([group, enabled])
}

model Supplier {
  id                 String               @id @default(cuid())
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  tenantId           String
  name               String
  type               String?
  roles              String[]             @default([])
  contactName        String?
  phone              String?
  address            String?
  country            String?
  city               String?
  email              String?
  socialContact      String?
  specialties        String?
  defaultLeadTime    String?
  defaultMoq         String?
  paymentTerms       String?
  cooperationComment String?
  riskNote           String?
  remarks            String?
  status             String               @default("active")
  productionUnits    SupplierUnit[]
  sourceFabrics      Fabric[]             @relation("FabricSourceSupplier")
  fabricSuppliers    FabricSupplier[]
  greigeFabrics      GreigeFabric[]       @relation("GreigeSupplier")
  dyeingFinishings   DyeingFinishing[]    @relation("DyeingFactory")
  postProcesses      PostProcess[]        @relation("PostProcessFactory")
  stockInBatches     FabricStockInBatch[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, type])
}

model SupplierUnit {
  id                   String                @id @default(cuid())
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  tenantId             String
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId           String
  name                 String
  unitForm             String
  businessTypes        String[]
  status               String                @default("active")
  primaryBusiness      String?
  primaryProducts      String?
  materialScope        String?
  processCapabilities  String?
  restrictions         String?
  defaultMoq           String?
  regularLeadTime      String?
  peakLeadTime         String?
  supportsSampling     Boolean               @default(true)
  managerName          String?
  phone                String?
  socialContact        String?
  qualityFeatures      String?
  riskNote             String?
  remarks              String?
  fabricSuppliers      FabricSupplier[]      @relation("FabricSupplierProductionUnit")
  fabricSupplierQuotes FabricSupplierQuote[] @relation("FabricSupplierQuoteProductionUnit")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([tenantId, supplierId, name])
  @@index([tenantId])
  @@index([supplierId])
  @@index([tenantId, status])
}

model Fabric {
  id                      String               @id @default(cuid())
  tenant                  Tenant               @relation(fields: [tenantId], references: [id])
  tenantId                String
  code                    String               @db.VarChar(64)
  englishName             String?
  name                    String
  fabricType              FabricType
  pricingUnit             PricingUnit
  developmentSource       String
  status                  String               @default("incomplete")
  composition             String
  weight                  String
  width                   String
  yarnCount               String?
  warpWeftDensity         String?
  category                String?
  structure               String?
  tags                    String[]
  usageOptionKeys         String[]
  seasonOptionKeys        String[]
  certificationOptionKeys String[]
  elasticity              String?
  supplier                Supplier?            @relation("FabricSourceSupplier", fields: [supplierId], references: [id])
  supplierId              String?
  sourceContact           String?
  sourceDate              DateTime?
  finishedReferencePrice  Decimal?             @db.Decimal(12, 2)
  supplierQuote           Decimal?             @db.Decimal(12, 2)
  minimumOrderQty         String?
  repurchaseStatus        String?
  tubeWeight              String?
  tolerance               String?
  greigeStatus            ProcessInfoStatus    @default(pending)
  dyeingStatus            ProcessInfoStatus    @default(pending)
  postProcessStatus       ProcessInfoStatus    @default(pending)
  colorFastness           String?
  pilling                 String?
  inspectionConclusion    String?
  handFeel                String?
  remarks                 String?
  completenessPercent     Int                  @default(0)
  missingInfoFlags        String[]
  greige                  GreigeFabric?
  dyeingFinishing         DyeingFinishing?
  postProcesses           PostProcess[]
  supplierSources         FabricSupplier[]
  stockInBatches          FabricStockInBatch[]
  sampleRequestItems      SampleRequestItem[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, fabricType])
  @@index([tenantId, developmentSource])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
}

model FabricSupplier {
  id                 String                @id @default(cuid())
  tenant             Tenant                @relation(fields: [tenantId], references: [id])
  tenantId           String
  fabric             Fabric                @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId           String
  supplier           Supplier              @relation(fields: [supplierId], references: [id])
  supplierId         String
  supplierUnit       SupplierUnit?          @relation("FabricSupplierProductionUnit", fields: [supplierUnitId], references: [id], onDelete: SetNull)
  supplierUnitId     String?
  supplierFabricCode String?
  sampleStatus       String?
  qualityDifferences String?
  isPreferred        Boolean               @default(false)
  remarks            String?
  quotes             FabricSupplierQuote[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([tenantId, fabricId, supplierId])
  @@index([tenantId])
  @@index([tenantId, fabricId])
  @@index([tenantId, supplierId])
  @@index([tenantId, isPreferred])
  @@index([supplierUnitId])
}

model FabricSupplierQuote {
  id                 String         @id @default(cuid())
  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  tenantId           String
  fabricSupplier     FabricSupplier @relation(fields: [fabricSupplierId], references: [id], onDelete: Cascade)
  fabricSupplierId   String
  supplierUnit       SupplierUnit?  @relation("FabricSupplierQuoteProductionUnit", fields: [supplierUnitId], references: [id], onDelete: Restrict)
  supplierUnitId     String?
  purchasePrice      Decimal        @db.Decimal(12, 2)
  currency           String         @default("CNY") @db.VarChar(3)
  pricingUnit        PricingUnit
  minimumOrderQty    String?
  leadTime           String?
  contactName        String?
  quoteDate          DateTime       @default(now())
  qualityDifferences String?
  remarks            String?
  createdAt          DateTime       @default(now())

  @@index([tenantId])
  @@index([fabricSupplierId, quoteDate])
  @@index([supplierUnitId])
}

model GreigeFabric {
  id            String    @id @default(cuid())
  fabric        Fabric    @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId      String    @unique
  supplier      Supplier? @relation("GreigeSupplier", fields: [supplierId], references: [id])
  supplierId    String?
  code          String?
  name          String?
  composition   String?
  weight        String?
  width         String?
  yarnOrDensity String?
  unitPrice     Decimal?  @db.Decimal(12, 2)
  lossRate      String?
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([supplierId])
}

model DyeingFinishing {
  id          String    @id @default(cuid())
  fabric      Fabric    @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId    String    @unique
  processType String?
  factory     Supplier? @relation("DyeingFactory", fields: [factoryId], references: [id])
  factoryId   String?
  unitPrice   Decimal?  @db.Decimal(12, 2)
  lossRate    String?
  leadTime    String?
  cautions    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([factoryId])
}

model PostProcess {
  id                String    @id @default(cuid())
  fabric            Fabric    @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId          String
  processType       String?
  factory           Supplier? @relation("PostProcessFactory", fields: [factoryId], references: [id])
  factoryId         String?
  effectDescription String?
  unitPrice         Decimal?  @db.Decimal(12, 2)
  lossRate          String?
  minimumOrderQty   String?
  leadTime          String?
  riskNotes         String?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([fabricId])
  @@index([factoryId])
}

model FabricStockInBatch {
  id               String      @id @default(cuid())
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  tenantId         String
  fabric           Fabric      @relation(fields: [fabricId], references: [id])
  fabricId         String
  batchNo          String
  stockInSource    String
  supplier         Supplier?   @relation(fields: [supplierId], references: [id])
  supplierId       String?
  quantity         Decimal     @db.Decimal(14, 3)
  unit             PricingUnit
  unitPrice        Decimal?    @db.Decimal(12, 2)
  totalAmount      Decimal?    @db.Decimal(14, 2)
  vatOrLotNo       String?
  storageLocation  String?
  swatchQuantity   Int         @default(0)
  sampleQuantity   Int         @default(0)
  imageUrls        String[]
  isDataComplete   Boolean     @default(false)
  missingInfoFlags String[]
  remarks          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([tenantId, batchNo])
  @@index([tenantId])
  @@index([fabricId])
  @@index([supplierId])
}

model OperationLog {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  module     String
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, module])
  @@index([tenantId, createdAt])
}

model Customer {
  id                String             @id @default(cuid())
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  tenantId          String
  name              String
  type              String?
  level             String?
  status            String             @default("active")
  country           String?
  city              String?
  address           String?
  contactName       String?
  phone             String?
  email             String?
  socialContact     String?
  mainProducts      String?
  cooperationBrands String?
  paymentTerms      String?
  defaultCurrency   String?
  remarks           String?
  contacts          CustomerContact[]
  sampleRequests    SampleRequest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, type])
  @@index([tenantId, level])
  @@index([tenantId, status])
}

model CustomerContact {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  name         String
  title        String?
  department   String?
  phone        String?
  email        String?
  socialContact String?
  isPrimary    Boolean  @default(false)
  status       String   @default("active")
  remarks      String?
  sampleRequests SampleRequest[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, customerId, name])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
}

// Sample request = fabrics sent from us to a CUSTOMER. It is intentionally
// separate from FabricSupplier.sampleStatus, which tracks samples we received
// from suppliers. Status keys come from ConfigOption group
// "sample_request_status"; feedback results from "sample_feedback_result".
model SampleRequest {
  id               String              @id @default(cuid())
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  tenantId         String
  code             String              @db.VarChar(64)
  customer         Customer            @relation(fields: [customerId], references: [id])
  customerId       String
  contact          CustomerContact?    @relation(fields: [contactId], references: [id])
  contactId        String?
  status           String              @default("preparing")
  sentAt           DateTime?
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  carrier          String?
  trackingNo       String?
  receiverName     String?
  receiverPhone    String?
  receiverAddress  String?
  purpose          String?
  remark           String?
  items            SampleRequestItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, contactId])
  @@index([tenantId, createdAt])
}

model SampleRequestItem {
  id             String        @id @default(cuid())
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  tenantId       String
  request        SampleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId      String
  fabric         Fabric        @relation(fields: [fabricId], references: [id])
  fabricId       String
  // Snapshot of the fabric pricing unit at send time, so later fabric changes
  // never rewrite historical sample quantities.
  unit           String?
  quantity       Decimal?      @db.Decimal(12, 3)
  colorOrRemark  String?
  feedback       String?
  feedbackResult String?
  feedbackAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId, requestId])
  @@index([tenantId, fabricId])
}
