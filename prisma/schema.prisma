generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  active
  inactive
}

enum UserStatus {
  active
  inactive
}

enum FabricType {
  knitted
  woven
}

enum PricingUnit {
  kg
  meter
}

enum ConfigScope {
  system
  tenant
}

enum ProcessInfoStatus {
  none
  pending
  available
}

// Account provisioning lifecycle for admin-created users. It is deliberately
// separate from `User.status` (active/inactive): `status` is an operator's
// on/off switch, `provisioningStatus` records whether the account was fully
// provisioned (Better Auth credential + role assignment + audit log).
// Only `ready` accounts will be allowed to sign in (enforced later, not now).
enum UserProvisioningStatus {
  pending
  ready
  failed
}

// Fixed role catalogue (product decision: V1 has no custom roles).
// Stored as a database enum so the database itself rejects dirty values.
enum RoleKey {
  owner
  admin
  sales
  purchasing
  merchandiser
  viewer
}

// Throttle dimension for AuthLoginThrottle.
//   login_ip         -> keyed by a hashed client IP (credential stuffing)
//   login_identifier -> keyed by a hashed login identifier (unknown emails too)
enum AuthThrottleScope {
  login_ip
  login_identifier
}

// Audit log categories, aligned with the three static prototype filters.
enum OperationLogCategory {
  login_security
  user_permission
  business
}

enum OperationLogResult {
  success
  failure
}

model Tenant {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  status               TenantStatus          @default(active)
  users                User[]
  suppliers            Supplier[]
  supplierUnits        SupplierUnit[]
  configOptions        ConfigOption[]
  fabrics              Fabric[]
  fabricSuppliers      FabricSupplier[]
  fabricSupplierQuotes FabricSupplierQuote[]
  batches              FabricStockInBatch[]
  customers            Customer[]
  customerContacts     CustomerContact[]
  sampleRequests       SampleRequest[]
  sampleRequestItems   SampleRequestItem[]
  customerQuotes       CustomerQuote[]
  customerQuoteItems   CustomerQuoteItem[]
  salesOrders          SalesOrder[]
  salesOrderItems      SalesOrderItem[]
  logs                 OperationLog[]
  roleAssignments      UserRoleAssignment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model User {
  id        String         @id @default(cuid())
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  tenantId  String
  // Globally unique: Better Auth looks users up by email alone, and an email
  // identifies one human across tenants. Always stored trim()ed + lowercased.
  email     String         @unique
  username  String
  name      String
  emailVerified Boolean    @default(false)
  image     String?
  status    UserStatus     @default(active)
  mustChangePassword Boolean @default(false)
  lastLoginAt DateTime?
  failedLoginAttempts Int   @default(0)
  lockedUntil DateTime?
  passwordChangedAt DateTime?
  // Idempotency key of the admin "create user" request that produced this
  // account. Persisted so a retried or half-finished provisioning run can be
  // detected and recovered instead of creating a second account.
  provisioningRequestId String? @unique
  provisioningStatus UserProvisioningStatus @default(pending)
  provisionedAt DateTime?
  accounts  Account[]
  sessions  Session[]
  roleAssignments UserRoleAssignment[]
  logs      OperationLog[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Required by UserRoleAssignment's composite foreign key, so a role row can
  // never point at a user from another tenant.
  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@index([tenantId])
}

// Better Auth credential table. `password` holds the scrypt hash and is the
// ONLY place a password is ever stored. Nothing in this codebase writes to it
// directly: hashing and verification always go through auth.api.*.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Database session. No tenantId: tenancy is reached through Session -> User.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Global Better Auth infrastructure (password reset tokens). No tenantId.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// A user may hold several roles at once; effective permissions are the union.
model UserRoleAssignment {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  userId    String
  roleKey   RoleKey
  // Composite foreign key: (tenantId, userId) must match one User row, so a
  // tenant can never assign a role to another tenant's user.
  user      User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  // Audit snapshot of who granted the role. Intentionally NOT a relation:
  // Prisma rejects a composite relation whose scalar set mixes a required and
  // an optional column, so tenant boundary is enforced in the service layer
  // instead. See docs/DESIGN_AUTHORIZATION_AND_LOGIN.md 3.7.
  createdByUserId String?
  createdAt DateTime @default(now())

  @@unique([userId, roleKey])
  @@index([tenantId, roleKey])
}

// Login throttling. Needed on top of User.failedLoginAttempts because the
// latter can only count attempts against an account that already exists, and
// cannot slow down credential stuffing from one IP across many accounts.
// Better Auth's built-in rate limiter is not used: it only runs in its HTTP
// onRequest layer, which this project never mounts.
model AuthLoginThrottle {
  id              String             @id @default(cuid())
  scope           AuthThrottleScope
  // Irreversible digest (server-secret HMAC) of the IP or login identifier.
  // Never a plaintext email, never a raw IP.
  keyHash         String
  attemptCount    Int                @default(0)
  windowStartedAt DateTime           @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@index([scope, windowStartedAt])
}

model ConfigOption {
  id        String      @id @default(cuid())
  tenant    Tenant?     @relation(fields: [tenantId], references: [id])
  tenantId  String?
  ownerKey  String      @default("system")
  scope     ConfigScope @default(system)
  group     String
  key       String
  label     String
  sortOrder Int         @default(0)
  enabled   Boolean     @default(true)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([ownerKey, group, key])
  @@index([tenantId])
  @@index([ownerKey])
  @@index([group, enabled])
}

model Supplier {
  id                 String               @id @default(cuid())
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  tenantId           String
  name               String
  type               String?
  roles              String[]             @default([])
  contactName        String?
  phone              String?
  address            String?
  country            String?
  city               String?
  email              String?
  socialContact      String?
  specialties        String?
  defaultLeadTime    String?
  defaultMoq         String?
  paymentTerms       String?
  cooperationComment String?
  riskNote           String?
  remarks            String?
  status             String               @default("active")
  productionUnits    SupplierUnit[]
  sourceFabrics      Fabric[]             @relation("FabricSourceSupplier")
  fabricSuppliers    FabricSupplier[]
  greigeFabrics      GreigeFabric[]       @relation("GreigeSupplier")
  dyeingFinishings   DyeingFinishing[]    @relation("DyeingFactory")
  postProcesses      PostProcess[]        @relation("PostProcessFactory")
  stockInBatches     FabricStockInBatch[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, type])
}

model SupplierUnit {
  id                   String                @id @default(cuid())
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  tenantId             String
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId           String
  name                 String
  unitForm             String
  businessTypes        String[]
  status               String                @default("active")
  primaryBusiness      String?
  primaryProducts      String?
  materialScope        String?
  processCapabilities  String?
  restrictions         String?
  defaultMoq           String?
  regularLeadTime      String?
  peakLeadTime         String?
  supportsSampling     Boolean               @default(true)
  managerName          String?
  phone                String?
  socialContact        String?
  qualityFeatures      String?
  riskNote             String?
  remarks              String?
  fabricSuppliers      FabricSupplier[]      @relation("FabricSupplierProductionUnit")
  fabricSupplierQuotes FabricSupplierQuote[] @relation("FabricSupplierQuoteProductionUnit")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([tenantId, supplierId, name])
  @@index([tenantId])
  @@index([supplierId])
  @@index([tenantId, status])
}

model Fabric {
  id                      String               @id @default(cuid())
  tenant                  Tenant               @relation(fields: [tenantId], references: [id])
  tenantId                String
  code                    String               @db.VarChar(64)
  englishName             String?
  name                    String
  fabricType              FabricType
  pricingUnit             PricingUnit
  developmentSource       String
  status                  String               @default("incomplete")
  composition             String
  weight                  String
  width                   String
  yarnCount               String?
  warpWeftDensity         String?
  category                String?
  structure               String?
  tags                    String[]
  usageOptionKeys         String[]
  seasonOptionKeys        String[]
  certificationOptionKeys String[]
  elasticity              String?
  supplier                Supplier?            @relation("FabricSourceSupplier", fields: [supplierId], references: [id])
  supplierId              String?
  sourceContact           String?
  sourceDate              DateTime?
  // Prices are split into tax-exclusive and tax-inclusive values. Both are
  // entered by hand and stored as-is; nothing is derived from the other.
  finishedReferencePriceExclTax Decimal?            @db.Decimal(12, 2)
  finishedReferencePriceInclTax Decimal?            @db.Decimal(12, 2)
  finishedReferenceTaxRate      Decimal?            @db.Decimal(6, 3)
  supplierQuote           Decimal?             @db.Decimal(12, 2)
  minimumOrderQty         String?
  repurchaseStatus        String?
  tubeWeight              String?
  tolerance               String?
  greigeStatus            ProcessInfoStatus    @default(pending)
  dyeingStatus            ProcessInfoStatus    @default(pending)
  postProcessStatus       ProcessInfoStatus    @default(pending)
  colorFastness           String?
  pilling                 String?
  inspectionConclusion    String?
  handFeel                String?
  remarks                 String?
  completenessPercent     Int                  @default(0)
  missingInfoFlags        String[]
  greigeFabrics           GreigeFabric[]
  dyeingFinishings        DyeingFinishing[]
  postProcesses           PostProcess[]
  supplierSources         FabricSupplier[]
  stockInBatches          FabricStockInBatch[]
  sampleRequestItems      SampleRequestItem[]
  customerQuoteItems      CustomerQuoteItem[]
  salesOrderItems         SalesOrderItem[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, fabricType])
  @@index([tenantId, developmentSource])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
}

model FabricSupplier {
  id                 String                @id @default(cuid())
  tenant             Tenant                @relation(fields: [tenantId], references: [id])
  tenantId           String
  fabric             Fabric                @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId           String
  supplier           Supplier              @relation(fields: [supplierId], references: [id])
  supplierId         String
  supplierUnit       SupplierUnit?          @relation("FabricSupplierProductionUnit", fields: [supplierUnitId], references: [id], onDelete: SetNull)
  supplierUnitId     String?
  supplierFabricCode String?
  sampleStatus       String?
  qualityDifferences String?
  isPreferred        Boolean               @default(false)
  remarks            String?
  quotes             FabricSupplierQuote[]
  salesOrderItems    SalesOrderItem[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([tenantId, fabricId, supplierId])
  @@index([tenantId])
  @@index([tenantId, fabricId])
  @@index([tenantId, supplierId])
  @@index([tenantId, isPreferred])
  @@index([supplierUnitId])
}

model FabricSupplierQuote {
  id                 String         @id @default(cuid())
  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  tenantId           String
  fabricSupplier     FabricSupplier @relation(fields: [fabricSupplierId], references: [id], onDelete: Cascade)
  fabricSupplierId   String
  supplierUnit       SupplierUnit?  @relation("FabricSupplierQuoteProductionUnit", fields: [supplierUnitId], references: [id], onDelete: Restrict)
  supplierUnitId     String?
  purchasePriceExclTax Decimal        @db.Decimal(12, 2)
  purchasePriceInclTax Decimal?       @db.Decimal(12, 2)
  purchaseTaxRate      Decimal?       @db.Decimal(6, 3)
  currency           String         @default("CNY") @db.VarChar(3)
  pricingUnit        PricingUnit
  minimumOrderQty    String?
  leadTime           String?
  contactName        String?
  quoteDate          DateTime       @default(now())
  qualityDifferences String?
  remarks            String?
  customerQuoteItems CustomerQuoteItem[]
  salesOrderItems    SalesOrderItem[]
  createdAt          DateTime       @default(now())

  @@index([tenantId])
  @@index([fabricSupplierId, quoteDate])
  @@index([supplierUnitId])
}

model GreigeFabric {
  id            String    @id @default(cuid())
  fabric        Fabric    @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId      String
  supplier      Supplier? @relation("GreigeSupplier", fields: [supplierId], references: [id])
  supplierId    String?
  code          String?
  name          String?
  composition   String?
  weight        String?
  width         String?
  yarnOrDensity String?
  unitPriceExclTax Decimal?  @db.Decimal(12, 2)
  unitPriceInclTax Decimal?  @db.Decimal(12, 2)
  taxRate          Decimal?  @db.Decimal(6, 3)
  lossRate      String?
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([fabricId])
  @@index([supplierId])
}

model DyeingFinishing {
  id          String    @id @default(cuid())
  fabric      Fabric    @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId    String
  processType String?
  factory     Supplier? @relation("DyeingFactory", fields: [factoryId], references: [id])
  factoryId   String?
  unitPriceExclTax Decimal?  @db.Decimal(12, 2)
  unitPriceInclTax Decimal?  @db.Decimal(12, 2)
  taxRate          Decimal?  @db.Decimal(6, 3)
  lossRate    String?
  leadTime    String?
  cautions    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([fabricId])
  @@index([factoryId])
}

model PostProcess {
  id                String    @id @default(cuid())
  fabric            Fabric    @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricId          String
  processType       String?
  factory           Supplier? @relation("PostProcessFactory", fields: [factoryId], references: [id])
  factoryId         String?
  effectDescription String?
  unitPriceExclTax  Decimal?  @db.Decimal(12, 2)
  unitPriceInclTax  Decimal?  @db.Decimal(12, 2)
  taxRate           Decimal?  @db.Decimal(6, 3)
  lossRate          String?
  minimumOrderQty   String?
  leadTime          String?
  riskNotes         String?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([fabricId])
  @@index([factoryId])
}

model FabricStockInBatch {
  id               String      @id @default(cuid())
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  tenantId         String
  fabric           Fabric      @relation(fields: [fabricId], references: [id])
  fabricId         String
  batchNo          String
  stockInSource    String
  supplier         Supplier?   @relation(fields: [supplierId], references: [id])
  supplierId       String?
  quantity         Decimal     @db.Decimal(14, 3)
  unit             PricingUnit
  unitPrice        Decimal?    @db.Decimal(12, 2)
  totalAmount      Decimal?    @db.Decimal(14, 2)
  vatOrLotNo       String?
  storageLocation  String?
  swatchQuantity   Int         @default(0)
  sampleQuantity   Int         @default(0)
  imageUrls        String[]
  isDataComplete   Boolean     @default(false)
  missingInfoFlags String[]
  remarks          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([tenantId, batchNo])
  @@index([tenantId])
  @@index([fabricId])
  @@index([supplierId])
}

model OperationLog {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  // Snapshots keep the log stable when a user is renamed or deleted.
  actorNameSnapshot  String?
  actorEmailSnapshot String?
  category   OperationLogCategory @default(business)
  module     String
  action     String
  targetType String?
  targetId   String?
  targetLabel String?
  result     OperationLogResult   @default(success)
  detail     Json?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Every index is prefixed with tenantId: logs are only ever queried inside
  // one tenant, so a global single-column index is pure write amplification.
  @@index([tenantId])
  @@index([tenantId, module])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, category, createdAt])
  @@index([tenantId, module, createdAt])
  @@index([tenantId, module, action])
  @@index([tenantId, result])
  @@index([tenantId, requestId])
}

model Customer {
  id                String             @id @default(cuid())
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  tenantId          String
  name              String
  type              String?
  level             String?
  status            String             @default("active")
  country           String?
  city              String?
  address           String?
  contactName       String?
  phone             String?
  email             String?
  socialContact     String?
  mainProducts      String?
  cooperationBrands String?
  paymentTerms      String?
  defaultCurrency   String?
  remarks           String?
  contacts          CustomerContact[]
  sampleRequests    SampleRequest[]
  quotes            CustomerQuote[]
  salesOrders       SalesOrder[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, type])
  @@index([tenantId, level])
  @@index([tenantId, status])
}

model CustomerContact {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  name         String
  title        String?
  department   String?
  phone        String?
  email        String?
  socialContact String?
  isPrimary    Boolean  @default(false)
  status       String   @default("active")
  remarks      String?
  sampleRequests SampleRequest[]
  quotes       CustomerQuote[]
  salesOrders  SalesOrder[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, customerId, name])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
}

// Sample request = fabrics sent from us to a CUSTOMER. It is intentionally
// separate from FabricSupplier.sampleStatus, which tracks samples we received
// from suppliers. Status keys come from ConfigOption group
// "sample_request_status"; feedback results from "sample_feedback_result".
model SampleRequest {
  id               String              @id @default(cuid())
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  tenantId         String
  code             String              @db.VarChar(64)
  customer         Customer            @relation(fields: [customerId], references: [id])
  customerId       String
  contact          CustomerContact?    @relation(fields: [contactId], references: [id])
  contactId        String?
  status           String              @default("preparing")
  sentAt           DateTime?
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  carrier          String?
  trackingNo       String?
  receiverName     String?
  receiverPhone    String?
  receiverAddress  String?
  purpose          String?
  remark           String?
  items            SampleRequestItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, contactId])
  @@index([tenantId, createdAt])
}

model SampleRequestItem {
  id             String        @id @default(cuid())
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  tenantId       String
  request        SampleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId      String
  fabric         Fabric        @relation(fields: [fabricId], references: [id])
  fabricId       String
  // Snapshot of the fabric pricing unit at send time, so later fabric changes
  // never rewrite historical sample quantities.
  unit           String?
  quantity       Decimal?      @db.Decimal(12, 3)
  colorOrRemark  String?
  feedback       String?
  feedbackResult String?
  feedbackAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId, requestId])
  @@index([tenantId, fabricId])
}

// Customer quote = what we offer to a CUSTOMER. It is deliberately separate
// from FabricSupplierQuote (what suppliers charge us) so quoting never
// overwrites purchase price history. Status keys come from ConfigOption group
// "customer_quote_status". version is reserved for future re-quote revisions.
model CustomerQuote {
  id            String              @id @default(cuid())
  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  tenantId      String
  code          String              @db.VarChar(64)
  customer      Customer            @relation(fields: [customerId], references: [id])
  customerId    String
  contact       CustomerContact?    @relation(fields: [contactId], references: [id])
  contactId     String?
  status        String              @default("draft")
  version       Int                 @default(1)
  currency      String              @default("CNY") @db.VarChar(3)
  // CNY per one unit of `currency`, pinned to 1 for CNY quotes so a stored
  // quote always reports the margin it was priced with.
  exchangeRate  Decimal             @default(1) @db.Decimal(14, 6)
  quoteDate     DateTime            @default(now())
  validUntil    DateTime?
  priceTerms    String?
  deliveryTerms String?
  leadTime      String?
  paymentTerms  String?
  taxRate       Decimal?            @db.Decimal(6, 3)
  remark        String?
  sentAt        DateTime?
  decidedAt     DateTime?
  items         CustomerQuoteItem[]
  orders        SalesOrder[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, contactId])
  @@index([tenantId, quoteDate])
}

model CustomerQuoteItem {
  id                    String               @id @default(cuid())
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  tenantId              String
  quote                 CustomerQuote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId               String
  fabric                Fabric               @relation(fields: [fabricId], references: [id])
  fabricId              String
  // Optional link to the purchase quote backing this price. costPrice is a
  // snapshot, so later supplier price changes never rewrite this quote.
  fabricSupplierQuote   FabricSupplierQuote? @relation(fields: [fabricSupplierQuoteId], references: [id], onDelete: SetNull)
  fabricSupplierQuoteId String?
  unit                  String?
  quantity              Decimal?             @db.Decimal(12, 3)
  minimumOrderQty       String?
  unitPrice             Decimal              @db.Decimal(12, 2)
  costPrice             Decimal?             @db.Decimal(12, 2)
  taxRate               Decimal?             @db.Decimal(6, 3)
  leadTime              String?
  colorOrRemark         String?
  remark                String?
  sortOrder             Int                  @default(0)
  orderItems            SalesOrderItem[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([tenantId, quoteId])
  @@index([tenantId, fabricId])
  @@index([fabricSupplierQuoteId])
}

// Sales order = what the CUSTOMER actually ordered, downstream of an accepted
// customer quote. Quotes are proposals; orders are commitments. Status keys
// come from ConfigOption group "sales_order_status".
model SalesOrder {
  id                     String            @id @default(cuid())
  tenant                 Tenant            @relation(fields: [tenantId], references: [id])
  tenantId               String
  code                   String            @db.VarChar(64)
  customer               Customer          @relation(fields: [customerId], references: [id])
  customerId             String
  contact                CustomerContact?  @relation(fields: [contactId], references: [id])
  contactId              String?
  // Where this order came from. Traceability only: turning a quote into an
  // order copies its lines once, and the two never sync afterwards.
  sourceQuote            CustomerQuote?    @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  sourceQuoteId          String?
  status                 String            @default("draft")
  orderDate              DateTime          @default(now())
  requestedDeliveryDate  DateTime?
  currency               String            @default("CNY") @db.VarChar(3)
  // 1 unit of `currency` = N CNY, pinned to 1 for CNY orders so the stored
  // margin never drifts with today's rate.
  exchangeRate           Decimal           @default(1) @db.Decimal(14, 6)
  priceTerms             String?
  deliveryTerms          String?
  paymentTerms           String?
  taxRate                Decimal?          @db.Decimal(6, 3)
  receiverName           String?
  receiverPhone          String?
  receiverAddress        String?
  remark                 String?
  confirmedAt            DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  items                  SalesOrderItem[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, contactId])
  @@index([tenantId, orderDate])
  @@index([tenantId, requestedDeliveryDate])
  @@index([tenantId, sourceQuoteId])
}

model SalesOrderItem {
  id                    String               @id @default(cuid())
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  tenantId              String
  order                 SalesOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId               String
  fabric                Fabric               @relation(fields: [fabricId], references: [id])
  fabricId              String
  // Traceability back to the quote line this was created from.
  sourceQuoteItem       CustomerQuoteItem?   @relation(fields: [sourceQuoteItemId], references: [id], onDelete: SetNull)
  sourceQuoteItemId     String?
  // Purchase side, kept for reference only: which supplier source we will buy
  // from and which quote priced it. Neither is written back to.
  fabricSupplier        FabricSupplier?      @relation(fields: [fabricSupplierId], references: [id], onDelete: SetNull)
  fabricSupplierId      String?
  fabricSupplierQuote   FabricSupplierQuote? @relation(fields: [fabricSupplierQuoteId], references: [id], onDelete: SetNull)
  fabricSupplierQuoteId String?
  // Snapshot of the fabric pricing unit at order time, so later fabric edits
  // never rewrite historical order quantities.
  unit                  String?
  // Filled when the order is hand-made or confirmed. A line copied from a
  // quote that carried no quantity stays empty until the operator fills it in;
  // confirming the order requires every line to have one.
  quantity              Decimal?             @db.Decimal(12, 3)
  deliveredQuantity     Decimal              @default(0) @db.Decimal(12, 3)
  unitPrice             Decimal              @db.Decimal(12, 2)
  costPrice             Decimal?             @db.Decimal(12, 2)
  taxRate               Decimal?             @db.Decimal(6, 3)
  leadTime              String?
  colorOrRemark         String?
  remark                String?
  sortOrder             Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([tenantId, orderId])
  @@index([tenantId, fabricId])
  @@index([fabricSupplierId])
  @@index([fabricSupplierQuoteId])
  @@index([sourceQuoteItemId])
}
